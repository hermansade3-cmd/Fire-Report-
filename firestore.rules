rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Workplace: profiles zinaonekana kwa wote walioingia; kila mtu anaandika yake tu
    match /wp_profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid && request.resource.data.role == 'officer';
      allow update: if request.auth.uid == uid
                    && request.resource.data.role == resource.data.role; // hawezi kujipandisha cheo
    }

    // Taarifa binafsi (service number): mmiliki tu
    match /wp_private/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Weka rules zako za sasa (users/..., chats/...) hapa chini, zisifutwe.
  }
}
